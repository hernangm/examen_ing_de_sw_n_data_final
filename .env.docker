# Airflow Configuration for Docker
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Airflow Web UI Credentials
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Additional pip packages (optional)
# _PIP_ADDITIONAL_REQUIREMENTS=

# Project-specific paths (these are set in docker-compose.yml)
# AIRFLOW_HOME=/opt/airflow
# DBT_PROFILES_DIR=/opt/airflow/profiles
# DUCKDB_PATH=/opt/airflow/warehouse/medallion.duckdb
# AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
# AIRFLOW__CORE__LOAD_EXAMPLES=False
